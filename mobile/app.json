{
  "expo": {
    "name": "Hemabridge",
    "slug": "hemabridge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#990011"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.hemabridge.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#990011"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "0711798b-ed70-458e-be3e-492d900dd4e9"
      }
    },
    "owner": "michelle29"
  }
}
